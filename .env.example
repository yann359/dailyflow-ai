# 服务端变量，绝不能使用 NEXT_PUBLIC_ 前缀
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
# cn（默认）或 global，分别使用官方中国/国际 API
MOONSHOT_REGION=cn
ARK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_AI_API_KEY=
# 自定义接口仅接受精确域名，不支持通配符、IP、HTTP 或内网
AI_CUSTOM_ALLOWED_HOSTS=
# 配置密钥后还必须启用，并设置独立的访问口令以避免公开接口被滥用
AI_ENABLED=false
AI_ACCESS_CODE=
# 三个独立随机值，各至少32字符；不要填服务商密钥，管理员口令不得与访问口令相同
AI_ADMIN_ACCESS_CODE=
AI_SESSION_SECRET=
AI_STORAGE_NAMESPACE=dailyflow-ai
AI_DAILY_REQUEST_LIMIT=30
AI_MONTHLY_REQUEST_LIMIT=300
AI_MONTHLY_BUDGET_USD=5
AI_TIMEOUT_MS=25000
# 多实例生产限流必须配置外部 Redis；不配置时 AI 在 Vercel 上保持关闭
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
